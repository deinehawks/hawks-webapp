                },
    "scripts":  {
                    "dev":  "set NEXT_DISABLE_TURBOPACK=1 \u0026\u0026 next dev",
                    "turbo-dev":  "next dev --turbo",
                    "update-tile-bounds":  "node scripts/update-tile-bounds.js",
                    "update-tile-bounds:force":  "node scripts/update-tile-bounds.js --force",
                    "build":  "next build",
                    "start":  "next start",
                    "lint":  "next lint",
                    "supabase:start":  "supabase start",
                    "supabase:stop":  "supabase stop",
                    "supabase:reset":  "supabase db reset --local",
                    "supabase:lint":  "supabase db lint --local --level warning",
                    "supabase:types":  "supabase gen types typescript --local --schema public \u003e lib/database.types.ts",
                    "migrate-detected-objects":  "node scripts/migrate-detected-objects.js",
                    "migrate-detected-objects:apply":  "node scripts/migrate-detected-objects.js --apply",
